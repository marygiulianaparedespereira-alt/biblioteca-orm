from datetime import datetime
from sqlalchemy import Column, Integer, String,ForeignKey, Boolean, create_engine, desc,asc,or_,DateTime
from sqlalchemy.orm import DeclarativeBase, Session


class Base(DeclarativeBase):
  pass

class Autor(Base):
    __tablename__ = "autor"

    id = Column(Integer, primary_key=True)
    nombre = Column(String)
    apellido = Column(String)
    nacionalidad = Column(String)


class Libro(Base):
    __tablename__ = "libros"

    id = Column(Integer, primary_key=True)
    titulo = Column(String)
    isbn = Column(String)
    anio = Column(DateTime)
    stock = Column(Integer)
    autor_id = Column(Integer, ForeignKey("autor.id"))


class Socio(Base):
    __tablename__ = "socio"

    id = Column(Integer, primary_key=True)
    nombre = Column(String)
    apellido = Column(String)
    email = Column(String)
    estado = Column(Boolean)


class Prestamo(Base):
    __tablename__ = "prestamo"

    id = Column(Integer, primary_key=True)
    fecha_inicio = Column(DateTime)
    fecha_devolucion = Column(DateTime)
    libro_id = Column(Integer, ForeignKey("libros.id"))
    socio_id = Column(Integer, ForeignKey("socio.id"))


engine = create_engine("sqlite:///mi_app.db")
